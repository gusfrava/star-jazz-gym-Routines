// ====== REALTIME SUBSCRIPTION ======
let unsubUsers = null, unsubLogs = null;
function subscribeRealtime(){
  if (!firebaseReady) return;
  if (unsubUsers) unsubUsers();
  if (unsubLogs) unsubLogs();
  unsubUsers = onSnapshot(doc(db,'salas',SALA), (snap)=>{
    if (snap.exists()){
      const newUsers = snap.data().users || [];
      const changed = JSON.stringify(newUsers) !== JSON.stringify(state.users);
      state.users = newUsers;
      if (changed) render();
    }
  }, (err)=> console.error('users sub error', err));
  unsubLogs = onSnapshot(collection(db,'salas',SALA,'logs'), (snap)=>{
    let changed = false;
    snap.docChanges().forEach(ch => {
      const id = ch.doc.id;
      const data = ch.doc.data();
      if (JSON.stringify(state.logs[id]) !== JSON.stringify(data)){
        state.logs[id] = data; changed = true;
      }
    });
    if (changed){ state.lastSync = new Date(); render(); }
  }, (err)=> console.error('logs sub error', err));
}

// ====== INIT ======
async function init(){
  if (!firebaseReady){
    showConfigBanner();
  }
  state.users = await loadUsers();
  state.logs = await loadAllLogs();
  const meId = loadMe();
  if (meId && state.users.find(u=>u.id===meId)){
    state.currentUser = meId;
    state.view = 'home';
  } else if (state.users.length === 0){
    state.setupStep = 'newName';
    state.view = 'setup';
  } else {
    state.setupStep = 'pickName';
    state.view = 'setup';
  }
  subscribeRealtime();
  render();
}

