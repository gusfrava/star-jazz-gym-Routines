// ====== RENDER ======
function render(){
  if (state.view === 'setup') return renderSetup();
  if (state.view === 'day') return renderDay();
  if (state.view === 'exercise') return renderExercise();
  if (state.view === 'compare') return renderCompare();
  return renderHome();
}

function syncIndicator(){
  if (!firebaseReady) return '';
  if (state.syncing) return `<span class="sync-pill"><span class="loader" style="width:8px;height:8px;border-width:1.5px;"></span>Sincronizando</span>`;
  return `<span class="sync-pill"><span class="pulse"></span>En la nube</span>`;
}

function configBanner(){
  if (firebaseReady) return '';
  return `<div style="background:var(--warning-bg);border:1px solid var(--warning);border-radius:var(--radius);padding:10px 12px;margin-bottom:14px;font-size:12px;color:var(--warning);">
    <strong>⚠ Modo local:</strong> Los datos solo se guardan en este navegador. Configura Firebase en index.html para sincronizar con tu gym buddy. Lee el README.
  </div>`;
}

function headerBar(title, backFn){
  const me = state.users.find(u=>u.id===state.currentUser);
  const userPill = me ? `<button data-action="switchUser" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;font-size:13px;">
    <span class="dot" style="background:${me.color};width:8px;height:8px;"></span>${esc(me.name)}
    <i class="ti ti-chevron-down" style="font-size:14px;"></i>
  </button>` : '';
  return `<div class="row" style="margin-bottom:16px;">
    ${backFn ? `<button data-action="${backFn}" aria-label="Volver" style="padding:6px 10px;"><i class="ti ti-arrow-left" style="font-size:18px;"></i></button>` : ''}
    <h1 style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(title)}</h1>
    <div class="spacer"></div>
    ${userPill}
  </div>
  ${configBanner()}`;
}

function renderSetup(){
  if (state.setupStep === 'pickName'){
    const userOptions = state.users.map(u => `
      <button data-action="pickUser" data-uid="${u.id}" style="display:flex;align-items:center;gap:10px;width:100%;padding:14px;text-align:left;font-size:15px;background:var(--bg-elev);">
        <span class="dot" style="background:${u.color};"></span>${esc(u.name)}
      </button>`).join('');
    root.innerHTML = `
      <div style="max-width:420px;margin:0 auto;padding-top:20px;">
        ${configBanner()}
        <h1 style="margin-bottom:6px;">¿Quién eres?</h1>
        <p class="muted" style="font-size:14px;margin:0 0 18px;">Selecciona tu nombre para registrar tu progreso.</p>
        <div style="display:flex;flex-direction:column;gap:8px;">${userOptions}</div>
        <button data-action="newUser" style="margin-top:14px;width:100%;padding:12px;border-style:dashed;color:var(--text-muted);">
          <i class="ti ti-plus" style="font-size:16px;vertical-align:-2px;"></i> Agregar otra persona
        </button>
      </div>`;
    attach(); return;
  }
  root.innerHTML = `
    <div style="max-width:420px;margin:0 auto;padding-top:20px;">
      ${configBanner()}
      <h1 style="margin-bottom:6px;">Bienvenido al gym 💪</h1>
      <p class="muted" style="font-size:14px;margin:0 0 18px;">Ingresa tu nombre para empezar. Tu compañero también podrá agregarse y verán el progreso del otro en tiempo real.</p>
      <input id="nameInput" type="text" placeholder="Tu nombre" maxlength="20" style="margin-bottom:10px;" autofocus />
      <button class="primary" data-action="createUser" style="width:100%;padding:12px;font-weight:600;">Empezar</button>
      ${state.users.length > 0 ? `<button data-action="backToPick" style="margin-top:10px;width:100%;padding:10px;border:none;background:transparent;font-size:13px;color:var(--text-muted);">← Volver a la lista</button>` : ''}
    </div>`;
  attach();
  setTimeout(()=> { const i = document.getElementById('nameInput'); if (i) i.focus(); }, 50);
}

function renderHome(){
  const others = state.users.filter(u=>u.id!==state.currentUser);
  const lastByUser = state.users.map(u=>{
    let latest = null;
    const ul = state.logs[u.id] || {};
    for (const k in ul) for (const e of ul[k]){
      if (!latest || e.date > latest.date) latest = { date:e.date, exKey:k };
    }
    return { user:u, latest };
  });

  const dayCards = DAYS.map(dk => {
    const r = ROUTINE[dk];
    const totalEx = r.exercises.length;
    let logged = 0;
    const ws = new Date(); ws.setDate(ws.getDate()-((ws.getDay()+6)%7));
    const wss = ws.toISOString().slice(0,10);
    for (let i=0;i<totalEx;i++){
      const ek = exerciseKey(dk,i);
      if (getEntries(state.currentUser, ek).some(e => e.date >= wss)) logged++;
    }
    return `<button data-action="openDay" data-day="${dk}" style="display:block;width:100%;text-align:left;padding:14px 16px;margin-bottom:8px;background:var(--bg-elev);">
      <div class="row">
        <div style="width:40px;height:40px;border-radius:var(--radius-sm);background:var(--bg-elev-2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="ti ${r.icon}" style="font-size:20px;color:var(--text-muted);"></i>
        </div>
        <div style="min-width:0;flex:1;">
          <div style="font-size:15px;font-weight:500;">${r.label}</div>
          <div class="muted" style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${r.focus}</div>
        </div>
        <span class="muted" style="font-size:12px;">${logged}/${totalEx}</span>
        <i class="ti ti-chevron-right" style="font-size:18px;color:var(--text-dim);"></i>
      </div>
    </button>`;
  }).join('');

  const partnersBlock = others.length ? `
    <div style="margin-top:24px;">
      <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Compañeros</div>
      ${others.map(u=>{
        const last = lastByUser.find(x=>x.user.id===u.id);
        const lastTxt = last && last.latest ? `Último entreno: ${last.latest.date}` : 'Sin entrenos registrados';
        return `<div class="row" style="padding:10px 12px;background:var(--bg-elev-2);border-radius:var(--radius-sm);margin-bottom:6px;">
          <span class="dot" style="background:${u.color};"></span>
          <div style="flex:1;">
            <div style="font-size:14px;font-weight:500;">${esc(u.name)}</div>
            <div class="muted" style="font-size:12px;">${lastTxt}</div>
          </div>
        </div>`;
      }).join('')}
    </div>` : `
    <div style="margin-top:24px;padding:14px;background:var(--bg-elev-2);border-radius:var(--radius-sm);font-size:13px;color:var(--text-muted);">
      <i class="ti ti-users" style="font-size:16px;vertical-align:-2px;"></i> Cuando tu compañero entre, se agregará aquí y verán el progreso del otro.
    </div>`;

  const me = state.users.find(u=>u.id===state.currentUser);
  root.innerHTML = `
    ${configBanner()}
    <div class="row" style="margin-bottom:16px;">
      <h1>Mi rutina</h1>
      <div class="spacer"></div>
      ${syncIndicator()}
      ${me ? `<button data-action="switchUser" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;font-size:13px;">
        <span class="dot" style="background:${me.color};width:8px;height:8px;"></span>${esc(me.name)}
        <i class="ti ti-chevron-down" style="font-size:14px;"></i>
      </button>` : ''}
    </div>
    <button data-action="goCompare" style="width:100%;padding:12px;margin-bottom:16px;background:var(--bg-elev-2);display:flex;align-items:center;justify-content:center;gap:6px;font-weight:500;">
      <i class="ti ti-chart-line" style="font-size:16px;"></i> Ver progreso
    </button>
    ${dayCards}
    ${partnersBlock}`;
  attach();
}

function renderDay(){
  const r = ROUTINE[state.currentDay];
  const me = state.users.find(u=>u.id===state.currentUser);
  const meColor = me ? me.color : 'var(--border)';
  const exList = r.exercises.map((ex,idx)=>{
    const ek = exerciseKey(state.currentDay, idx);
    const myLatest = latestEntry(state.currentUser, ek);
    const others = state.users.filter(u=>u.id!==state.currentUser);
    const meDot = `<span class="dot" title="Tú" style="width:8px;height:8px;background:${myLatest?meColor:'transparent'};border:1px solid ${myLatest?meColor:'var(--border)'};"></span>`;
    const otherDots = others.map(u=>{
      const has = getEntries(u.id, ek).length > 0;
      return `<span class="dot" title="${esc(u.name)}" style="width:8px;height:8px;background:${has?u.color:'transparent'};border:1px solid ${has?u.color:'var(--border)'};"></span>`;
    }).join('');
    const { primLabels } = muscleLabels(ex.primary, ex.secondary);
    const musclePill = primLabels.slice(0,2).join(' · ');
    const lastInfo = myLatest ? `Último: ${myLatest.date} · ${myLatest.sets.length} sets` : 'Sin registros';
    return `<button data-action="openEx" data-idx="${idx}" style="display:block;width:100%;text-align:left;padding:12px 14px;margin-bottom:8px;background:var(--bg-elev);">
      <div class="row">
        <div style="min-width:0;flex:1;">
          <div style="font-size:14px;font-weight:500;margin-bottom:3px;">${esc(ex.name)}</div>
          <div class="muted" style="font-size:12px;">${esc(musclePill)} · ${lastInfo}</div>
        </div>
        <div style="display:flex;gap:3px;">${meDot}${otherDots}</div>
        <i class="ti ti-chevron-right" style="font-size:18px;color:var(--text-dim);"></i>
      </div>
    </button>`;
  }).join('');

  root.innerHTML = `
    ${headerBar(r.label + ' · ' + r.focus, 'goHome')}
    <div class="muted" style="font-size:12px;margin-bottom:12px;">
      <i class="ti ti-info-circle" style="font-size:14px;vertical-align:-2px;"></i> Toca un ejercicio para registrar sets, ver video, músculos o alternativas.
    </div>
    ${exList}`;
  attach();
}

function renderExercise(){
  const r = ROUTINE[state.currentDay];
  const ex = r.exercises[state.currentExerciseIdx];
  const ek = exerciseKey(state.currentDay, state.currentExerciseIdx);
  const myEntries = getEntries(state.currentUser, ek).slice().sort((a,b)=>b.date.localeCompare(a.date));
  const lastEntry = myEntries[0]; const prevEntry = myEntries[1];

  const initialCount = lastEntry ? lastEntry.sets.length : 4;
  const setRows = [];
  for (let i=0;i<initialCount;i++){
    const ph_r = lastEntry ? (lastEntry.sets[i] && lastEntry.sets[i].reps) || '' : '';
    const ph_w = lastEntry ? (lastEntry.sets[i] && lastEntry.sets[i].weight) || '' : '';
    const ph_n = lastEntry ? (lastEntry.sets[i] && lastEntry.sets[i].note) || '' : '';
    setRows.push(`<div class="set-row" style="margin-bottom:10px;padding:8px;background:var(--bg-elev-2);border-radius:var(--radius-sm);">
      <div style="display:grid;grid-template-columns:28px 1fr 1fr 28px;gap:6px;align-items:center;margin-bottom:4px;">
        <div class="muted" style="font-size:13px;text-align:center;font-weight:500;">${i+1}</div>
        <input type="number" class="reps-in" inputmode="numeric" min="0" placeholder="${ph_r || 'reps'}" style="text-align:center;padding:8px;" />
        <input type="number" class="weight-in" inputmode="decimal" step="0.5" min="0" placeholder="${ph_w ? ph_w+' lb' : 'peso lb'}" style="text-align:center;padding:8px;" />
        <button class="del-set" aria-label="Eliminar" style="padding:4px;border:none;color:var(--text-dim);"><i class="ti ti-x" style="font-size:14px;"></i></button>
      </div>
      <input type="text" class="note-in" placeholder="${ph_n ? 'Nota anterior: '+esc(ph_n) : 'Nota del set (opcional)'}" maxlength="120" style="width:100%;font-size:12px;padding:6px 10px;" />
    </div>`);
  }

  // History
  const historyRows = [];
  for (const u of state.users){
    const entries = getEntries(u.id, ek).slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,5);
    for (const e of entries){
      const best = bestSet(e); const vol = totalVolume(e);
      const setNotes = (e.sets||[]).map((s,i)=> s.note ? `Set ${i+1}: ${s.note}` : null).filter(Boolean);
      historyRows.push({
        date:e.date, user:u,
        summary:`${e.sets.length} sets · max ${best ? best.weight+'lb × '+best.reps : '–'} · vol ${Math.round(vol)}`,
        sessionNote: e.note || null,
        setNotes
      });
    }
  }
  historyRows.sort((a,b)=>b.date.localeCompare(a.date));
  const historyList = historyRows.slice(0,8).map(h => `<div style="padding:10px;background:var(--bg-elev-2);border-radius:var(--radius-sm);margin-bottom:6px;">
    <div class="row">
      <span class="dot" style="background:${h.user.color};width:8px;height:8px;"></span>
      <div style="flex:1;min-width:0;">
        <div style="font-size:13px;font-weight:500;">${esc(h.user.name)} <span class="dim" style="font-weight:400;">· ${h.date}</span></div>
        <div class="muted" style="font-size:12px;">${h.summary}</div>
      </div>
    </div>
    ${h.sessionNote ? `<div style="margin-top:6px;padding:6px 8px;background:var(--bg-elev);border-radius:var(--radius-sm);font-size:12px;color:var(--text-muted);font-style:italic;"><i class="ti ti-message" style="font-size:12px;"></i> ${esc(h.sessionNote)}</div>` : ''}
    ${h.setNotes.length ? `<div class="dim" style="margin-top:4px;font-size:11px;padding-left:18px;">${h.setNotes.map(n=>esc(n)).join(' · ')}</div>` : ''}
  </div>`).join('') || '<div class="muted" style="font-size:13px;padding:10px;">Sin historial todavía. ¡Sé el primero!</div>';

  let progressBadge = '';
  if (lastEntry && prevEntry){
    const lb = bestSet(lastEntry); const pb = bestSet(prevEntry);
    if (lb && pb){
      const diff = (Number(lb.weight)||0) - (Number(pb.weight)||0);
      if (diff>0) progressBadge = `<span class="badge" style="background:var(--success-bg);color:var(--success);"><i class="ti ti-trending-up" style="font-size:12px;"></i>+${diff} lb</span>`;
      else if (diff<0) progressBadge = `<span class="badge" style="background:var(--warning-bg);color:var(--warning);"><i class="ti ti-trending-down" style="font-size:12px;"></i>${diff} lb</span>`;
      else progressBadge = `<span class="badge" style="background:var(--bg-elev-2);color:var(--text-muted);">Igual</span>`;
    }
  }

  const altsList = ex.alts.map(a=> `<li style="padding:6px 0;font-size:14px;color:var(--text-muted);border-bottom:1px solid var(--border);">${esc(a)}</li>`).join('');
  const videoUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(ex.video)}`;
  const { primLabels, secLabels } = muscleLabels(ex.primary, ex.secondary);
  const sessionNotePh = lastEntry && lastEntry.note ? 'Nota anterior: ' + lastEntry.note.slice(0,60) : 'Cómo te sentiste, observaciones, ajustes para la próxima…';

  root.innerHTML = `
    ${headerBar(ex.name, 'goDay')}
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
      <a href="${videoUrl}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;padding:8px 12px;background:var(--bg-elev-2);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:13px;text-decoration:none;color:var(--text);">
        <i class="ti ti-brand-youtube" style="font-size:16px;color:#ff0000;"></i> Video
      </a>
      <button data-action="toggleMuscles" style="background:${state.showMuscles?'var(--accent-bg)':'var(--bg-elev-2)'};color:${state.showMuscles?'var(--accent)':'var(--text)'};border-color:${state.showMuscles?'var(--accent-border)':'var(--border)'};">
        <i class="ti ti-body-scan" style="font-size:16px;"></i> Músculos
      </button>
      <button data-action="toggleAlts" style="background:${state.showAlts?'var(--accent-bg)':'var(--bg-elev-2)'};color:${state.showAlts?'var(--accent)':'var(--text)'};border-color:${state.showAlts?'var(--accent-border)':'var(--border)'};">
        <i class="ti ti-arrows-shuffle" style="font-size:16px;"></i> Alternativas
      </button>
      ${progressBadge}
    </div>

    ${state.showMuscles ? `<div class="card" style="margin-bottom:14px;">
      ${bodyDiagram(ex.primary, ex.secondary)}
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:12px;">
        <div class="row" style="font-size:13px;">
          <span class="dot" style="background:var(--accent);width:14px;height:14px;border-radius:3px;"></span>
          <span class="muted">Principal:</span>
          <span style="font-weight:500;">${primLabels.join(', ') || '—'}</span>
        </div>
        ${secLabels.length ? `<div class="row" style="font-size:13px;">
          <span class="dot" style="background:var(--warning);width:14px;height:14px;border-radius:3px;"></span>
          <span class="muted">Secundario:</span>
          <span style="font-weight:500;">${secLabels.join(', ')}</span>
        </div>` : ''}
      </div>
    </div>` : ''}

    ${state.showAlts ? `<div class="card" style="margin-bottom:14px;background:var(--bg-elev-2);">
      <div style="font-size:13px;font-weight:500;margin-bottom:6px;">Si la máquina está ocupada</div>
      <ul style="margin:0;padding:0;list-style:none;">${altsList}</ul>
    </div>` : ''}

    <div class="card" style="margin-bottom:16px;">
      <div class="row" style="margin-bottom:12px;">
        <h2>Registrar sesión</h2>
        <div class="spacer"></div>
        <input type="date" id="sessionDate" value="${today()}" style="width:auto;padding:6px 10px;font-size:13px;" />
      </div>
      <div class="dim" style="display:grid;grid-template-columns:28px 1fr 1fr 28px;gap:6px;margin-bottom:6px;padding:0 8px;font-size:10px;text-transform:uppercase;letter-spacing:0.05em;">
        <div style="text-align:center;">Set</div>
        <div style="text-align:center;">Reps</div>
        <div style="text-align:center;">Peso (lb)</div>
        <div></div>
      </div>
      <div id="setsContainer">${setRows.join('')}</div>
      <button data-action="addSet" style="margin-top:4px;width:100%;padding:10px;border-style:dashed;color:var(--text-muted);">
        <i class="ti ti-plus" style="font-size:14px;vertical-align:-2px;"></i> Agregar set
      </button>
      <div style="margin-top:14px;">
        <label class="muted" style="font-size:12px;display:block;margin-bottom:4px;">
          <i class="ti ti-message" style="font-size:13px;vertical-align:-1px;"></i> Comentario general
        </label>
        <textarea id="sessionNote" rows="2" maxlength="300" placeholder="${esc(sessionNotePh)}" style="resize:vertical;font-family:inherit;"></textarea>
      </div>
      <button class="primary" data-action="saveSession" style="margin-top:10px;width:100%;padding:12px;font-weight:600;">
        Guardar sesión
      </button>
      <div id="saveStatus" style="font-size:12px;color:var(--success);text-align:center;margin-top:8px;min-height:14px;"></div>
    </div>

    <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Historial reciente</div>
    ${historyList}

    <button data-action="goCompareEx" style="margin-top:14px;width:100%;padding:12px;">
      <i class="ti ti-chart-line" style="font-size:16px;vertical-align:-2px;"></i> Comparar progreso de este ejercicio
    </button>`;
  attach();
  attachSetHandlers();
}

function renderCompare(){
  const mode = state.compareMode;
  const focused = state.currentExerciseIdx != null ? { day: state.currentDay, idx: state.currentExerciseIdx } : null;

  const exerciseOptions = [`<option value="">Todos los ejercicios</option>`];
  for (const dk of DAYS){
    const r = ROUTINE[dk];
    exerciseOptions.push(`<optgroup label="${r.label} - ${r.focus}">`);
    r.exercises.forEach((ex,idx)=>{
      const val = dk+':'+idx;
      const sel = focused && focused.day===dk && focused.idx===idx ? ' selected' : '';
      exerciseOptions.push(`<option value="${val}"${sel}>${esc(ex.name)}</option>`);
    });
    exerciseOptions.push(`</optgroup>`);
  }

  function getExerciseStats(exKey){
    return state.users.map(u => ({ user:u, buckets: bucketEntries(getEntries(u.id, exKey), mode) }));
  }

  let content = '';
  if (focused){
    const ek = exerciseKey(focused.day, focused.idx);
    const ex = ROUTINE[focused.day].exercises[focused.idx];
    const stats = getExerciseStats(ek);
    const maxW = Math.max(1, ...stats.flatMap(s=>s.buckets.map(b=>b.maxWeight)));
    const allKeys = Array.from(new Set(stats.flatMap(s=>s.buckets.map(b=>b.key)))).sort();
    content = `<div class="card" style="margin-bottom:14px;">
      <div style="font-size:15px;font-weight:500;margin-bottom:4px;">${esc(ex.name)}</div>
      <div class="muted" style="font-size:12px;margin-bottom:14px;">Peso máximo por ${mode==='week'?'semana':mode==='month'?'mes':'año'}</div>
      ${renderBarChart(stats, allKeys, maxW)}
    </div>
    ${stats.map(s => renderUserStatCard(s)).join('')}`;
  } else {
    const byUser = state.users.map(u => {
      const ul = state.logs[u.id] || {};
      const all = []; for (const k in ul) for (const e of ul[k]) all.push(e);
      return { user:u, buckets: bucketEntries(all, mode), totalSessions: all.length };
    });
    const maxV = Math.max(1, ...byUser.flatMap(s=>s.buckets.map(b=>b.totalVolume)));
    const allKeys = Array.from(new Set(byUser.flatMap(s=>s.buckets.map(b=>b.key)))).sort();
    content = `<div class="card" style="margin-bottom:14px;">
      <div style="font-size:15px;font-weight:500;margin-bottom:4px;">Volumen total</div>
      <div class="muted" style="font-size:12px;margin-bottom:14px;">Reps × peso · por ${mode==='week'?'semana':mode==='month'?'mes':'año'}</div>
      ${renderBarChart(byUser.map(b=>({...b, buckets: b.buckets.map(x=>({...x, maxWeight: x.totalVolume}))})), allKeys, maxV, true)}
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;">
      ${byUser.map(s => `<div style="background:var(--bg-elev-2);border-radius:var(--radius-sm);padding:12px;">
        <div class="row" style="margin-bottom:6px;">
          <span class="dot" style="background:${s.user.color};width:8px;height:8px;"></span>
          <div style="font-size:13px;font-weight:500;">${esc(s.user.name)}</div>
        </div>
        <div class="dim" style="font-size:11px;text-transform:uppercase;">Sesiones</div>
        <div style="font-size:20px;font-weight:500;">${s.totalSessions}</div>
      </div>`).join('')}
    </div>`;
  }

  root.innerHTML = `
    ${headerBar('Comparar progreso', 'goHome')}
    <div style="display:flex;gap:6px;margin-bottom:12px;">
      ${['week','month','year'].map(m => `<button data-action="setMode" data-mode="${m}" style="flex:1;padding:10px;font-weight:500;background:${mode===m?'var(--accent-bg)':'transparent'};color:${mode===m?'var(--accent)':'var(--text-muted)'};border-color:${mode===m?'var(--accent-border)':'var(--border)'};">${m==='week'?'Semana':m==='month'?'Mes':'Año'}</button>`).join('')}
    </div>
    <select id="exPicker" style="margin-bottom:14px;">${exerciseOptions.join('')}</select>
    ${content}`;
  attach();
  const picker = document.getElementById('exPicker');
  if (picker) picker.addEventListener('change', e => {
    const v = e.target.value;
    if (!v){ state.currentDay = null; state.currentExerciseIdx = null; }
    else { const [d,i] = v.split(':'); state.currentDay = d; state.currentExerciseIdx = Number(i); }
    render();
  });
}

function renderBarChart(stats, allKeys, maxVal, isVolume){
  if (!allKeys.length){
    return `<div class="muted" style="padding:24px;text-align:center;font-size:13px;">Sin datos registrados todavía.</div>`;
  }
  const barW = Math.max(20, Math.min(80, 480 / (allKeys.length * state.users.length + allKeys.length)));
  const groupW = barW * state.users.length + 8;
  const cH = 160; const lH = 36;
  const bars = [];
  allKeys.forEach((k, gi) => {
    stats.forEach((s, ui) => {
      const b = s.buckets.find(x => x.key === k);
      const val = b ? b.maxWeight : 0;
      const h = Math.round((val / maxVal) * (cH - 10));
      const x = gi * (groupW + 12) + ui * barW;
      const y = cH - h;
      bars.push(`<g>
        <rect x="${x}" y="${y}" width="${barW - 2}" height="${h}" fill="${s.user.color}" rx="2"></rect>
        ${val ? `<text x="${x + barW/2 - 1}" y="${y - 3}" text-anchor="middle" font-size="10" fill="var(--text-muted)">${isVolume ? Math.round(val) : val}</text>` : ''}
      </g>`);
    });
    const gx = gi * (groupW + 12) + groupW/2;
    bars.push(`<text x="${gx}" y="${cH + 14}" text-anchor="middle" font-size="10" fill="var(--text-muted)">${formatBucket(k, state.compareMode)}</text>`);
  });
  const sW = allKeys.length * (groupW + 12);
  const legend = stats.map(s => `<div style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);">
    <span style="width:10px;height:10px;border-radius:2px;background:${s.user.color};"></span>${esc(s.user.name)}
  </div>`).join('');
  return `<div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
    <svg viewBox="0 0 ${sW} ${cH + lH}" width="${Math.max(sW, 320)}" height="${cH + lH}" style="display:block;">${bars.join('')}</svg>
  </div>
  <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:10px;">${legend}</div>`;
}

function renderUserStatCard(s){
  if (!s.buckets.length){
    return `<div style="background:var(--bg-elev-2);border-radius:var(--radius-sm);padding:12px 14px;margin-bottom:8px;">
      <div class="row" style="margin-bottom:6px;">
        <span class="dot" style="background:${s.user.color};"></span>
        <div style="font-size:14px;font-weight:500;">${esc(s.user.name)}</div>
      </div>
      <div class="muted" style="font-size:12px;">Sin registros</div>
    </div>`;
  }
  const f = s.buckets[0]; const l = s.buckets[s.buckets.length-1];
  const diff = l.maxWeight - f.maxWeight;
  const pct = f.maxWeight ? Math.round((diff/f.maxWeight)*100) : 0;
  const arrow = diff>0 ? '<i class="ti ti-trending-up" style="color:var(--success);"></i>' : diff<0 ? '<i class="ti ti-trending-down" style="color:var(--warning);"></i>' : '<i class="ti ti-minus" style="color:var(--text-muted);"></i>';
  return `<div class="card" style="margin-bottom:8px;">
    <div class="row" style="margin-bottom:8px;">
      <span class="dot" style="background:${s.user.color};"></span>
      <div style="font-size:14px;font-weight:500;">${esc(s.user.name)}</div>
      <div class="spacer"></div>
      <div style="display:flex;align-items:center;gap:6px;font-size:13px;">${arrow}<span>${diff>=0?'+':''}${diff} lb (${pct>=0?'+':''}${pct}%)</span></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      <div><div class="dim" style="font-size:11px;text-transform:uppercase;">Primer</div><div style="font-size:14px;font-weight:500;">${f.maxWeight} lb</div></div>
      <div><div class="dim" style="font-size:11px;text-transform:uppercase;">Último</div><div style="font-size:14px;font-weight:500;">${l.maxWeight} lb</div></div>
      <div><div class="dim" style="font-size:11px;text-transform:uppercase;">Sesiones</div><div style="font-size:14px;font-weight:500;">${s.buckets.reduce((x,b)=>x+b.sessions,0)}</div></div>
    </div>
  </div>`;
}

function formatBucket(key, mode){
  if (mode==='week'){ const d = new Date(key); return d.toLocaleDateString('es', {month:'short', day:'numeric'}); }
  if (mode==='month'){ const [y,m] = key.split('-'); return new Date(Number(y), Number(m)-1, 1).toLocaleDateString('es', {month:'short', year:'2-digit'}); }
  return key;
}

// ====== EVENTS ======
function attach(){ root.querySelectorAll('[data-action]').forEach(el => el.addEventListener('click', handle)); }
function attachSetHandlers(){ document.querySelectorAll('.del-set').forEach(b => b.addEventListener('click', e => e.target.closest('.set-row').remove())); }

async function handle(e){
  const btn = e.currentTarget; const a = btn.dataset.action;
  if (a === 'newUser'){ state.setupStep = 'newName'; render(); return; }
  if (a === 'backToPick'){ state.setupStep = 'pickName'; render(); return; }
  if (a === 'createUser'){
    const name = (document.getElementById('nameInput').value || '').trim();
    if (!name) return;
    const id = 'u_'+Date.now()+'_'+Math.random().toString(36).slice(2,7);
    const color = userColor(state.users.length);
    state.users.push({ id, name, color });
    await saveUsers(state.users);
    state.currentUser = id; saveMe(id);
    state.logs[id] = state.logs[id] || {};
    state.view = 'home'; render(); return;
  }
  if (a === 'pickUser'){
    state.currentUser = btn.dataset.uid; saveMe(state.currentUser);
    state.view = 'home'; render(); return;
  }
  if (a === 'switchUser'){
    state.setupStep = state.users.length ? 'pickName' : 'newName';
    state.view = 'setup'; render(); return;
  }
  if (a === 'openDay'){ state.currentDay = btn.dataset.day; state.view = 'day'; render(); return; }
  if (a === 'goHome'){ state.view = 'home'; state.currentDay = null; state.currentExerciseIdx = null; state.showAlts = false; state.showMuscles = false; render(); return; }
  if (a === 'goDay'){ state.view = 'day'; state.currentExerciseIdx = null; state.showAlts = false; state.showMuscles = false; render(); return; }
  if (a === 'openEx'){ state.currentExerciseIdx = Number(btn.dataset.idx); state.view = 'exercise'; state.showAlts = false; state.showMuscles = false; render(); return; }
  if (a === 'toggleAlts'){ state.showAlts = !state.showAlts; render(); return; }
  if (a === 'toggleMuscles'){ state.showMuscles = !state.showMuscles; render(); return; }
  if (a === 'addSet'){
    const c = document.getElementById('setsContainer'); const n = c.children.length + 1;
    const div = document.createElement('div');
    div.className = 'set-row';
    div.style.cssText = 'margin-bottom:10px;padding:8px;background:var(--bg-elev-2);border-radius:var(--radius-sm);';
    div.innerHTML = `<div style="display:grid;grid-template-columns:28px 1fr 1fr 28px;gap:6px;align-items:center;margin-bottom:4px;">
      <div class="muted" style="font-size:13px;text-align:center;font-weight:500;">${n}</div>
      <input type="number" class="reps-in" inputmode="numeric" min="0" placeholder="reps" style="text-align:center;padding:8px;" />
      <input type="number" class="weight-in" inputmode="decimal" step="0.5" min="0" placeholder="peso lb" style="text-align:center;padding:8px;" />
      <button class="del-set" aria-label="Eliminar" style="padding:4px;border:none;color:var(--text-dim);"><i class="ti ti-x" style="font-size:14px;"></i></button>
    </div>
    <input type="text" class="note-in" placeholder="Nota del set (opcional)" maxlength="120" style="width:100%;font-size:12px;padding:6px 10px;" />`;
    c.appendChild(div);
    div.querySelector('.del-set').addEventListener('click', ()=> div.remove());
    return;
  }
  if (a === 'saveSession'){
    const date = document.getElementById('sessionDate').value || today();
    const rows = document.querySelectorAll('.set-row');
    const sets = [];
    rows.forEach(r => {
      const reps = Number(r.querySelector('.reps-in').value);
      const weight = Number(r.querySelector('.weight-in').value);
      const note = (r.querySelector('.note-in').value || '').trim();
      if (reps > 0 && weight >= 0){ const s = { reps, weight }; if (note) s.note = note; sets.push(s); }
    });
    const sessionNote = (document.getElementById('sessionNote').value || '').trim();
    const status = document.getElementById('saveStatus');
    if (!sets.length){ status.style.color = 'var(--warning)'; status.textContent = 'Ingresa al menos un set con reps y peso.'; return; }
    const ek = exerciseKey(state.currentDay, state.currentExerciseIdx);
    const userLogs = state.logs[state.currentUser] || {};
    if (!userLogs[ek]) userLogs[ek] = [];
    const idx = userLogs[ek].findIndex(e => e.date === date);
    const entry = { date, sets }; if (sessionNote) entry.note = sessionNote;
    if (idx >= 0) userLogs[ek][idx] = entry; else userLogs[ek].push(entry);
    state.logs[state.currentUser] = userLogs;
    await saveUserLogs(state.currentUser, userLogs);
    status.style.color = 'var(--success)'; status.textContent = '✓ Guardado. Sigue así 💪';
    toast('Sesión guardada');
    setTimeout(()=> render(), 600);
    return;
  }
  if (a === 'goCompare'){ state.view = 'compare'; state.currentDay = null; state.currentExerciseIdx = null; render(); return; }
  if (a === 'goCompareEx'){ state.view = 'compare'; render(); return; }
  if (a === 'setMode'){ state.compareMode = btn.dataset.mode; render(); return; }
}

init();
</script>
</body>
</html>
