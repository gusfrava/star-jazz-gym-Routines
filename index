// ====== STORAGE ======
async function loadUsers(){
  if (!firebaseReady) return JSON.parse(localStorage.getItem('users')||'[]');
  try {
    const snap = await getDoc(doc(db, 'salas', SALA));
    return snap.exists() ? (snap.data().users || []) : [];
  } catch(e){ console.error(e); return []; }
}
async function saveUsers(users){
  if (!firebaseReady){ localStorage.setItem('users', JSON.stringify(users)); return; }
  state.syncing = true;
  try { await setDoc(doc(db, 'salas', SALA), { users }, { merge: true }); state.lastSync = new Date(); }
  catch(e){ console.error(e); toast('Error al guardar'); }
  state.syncing = false;
}
async function loadAllLogs(){
  if (!firebaseReady){
    const out = {}; const users = JSON.parse(localStorage.getItem('users')||'[]');
    for (const u of users){ out[u.id] = JSON.parse(localStorage.getItem('logs:'+u.id)||'{}'); }
    return out;
  }
  try {
    const out = {};
    const snap = await getDocs(collection(db, 'salas', SALA, 'logs'));
    snap.forEach(d => { out[d.id] = d.data(); });
    return out;
  } catch(e){ console.error(e); return {}; }
}
async function saveUserLogs(userId, logs){
  if (!firebaseReady){ localStorage.setItem('logs:'+userId, JSON.stringify(logs)); return; }
  state.syncing = true;
  try { await setDoc(doc(db, 'salas', SALA, 'logs', userId), logs); state.lastSync = new Date(); }
  catch(e){ console.error(e); toast('Error al guardar'); }
  state.syncing = false;
}
