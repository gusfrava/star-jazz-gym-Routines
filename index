const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const getEntries = (uid, ek) => (state.logs[uid] && state.logs[uid][ek]) || [];
const bestSet = (e) => !e.sets || !e.sets.length ? null : e.sets.reduce((b,s)=> (s.weight||0)>(b.weight||0)?s:b, e.sets[0]);
const totalVolume = (e) => !e.sets ? 0 : e.sets.reduce((s,x)=> s + (Number(x.reps)||0)*(Number(x.weight)||0), 0);
const latestEntry = (uid, ek) => {
  const a = getEntries(uid, ek);
  return a.length ? a.slice().sort((x,y)=>x.date.localeCompare(y.date)).pop() : null;
};
function bucketEntries(entries, mode){
  const b = {};
  for (const e of entries){
    let key;
    if (mode==='week'){
      const d = new Date(e.date); const day = (d.getDay()+6)%7;
      d.setDate(d.getDate()-day); key = d.toISOString().slice(0,10);
    } else if (mode==='month'){ key = e.date.slice(0,7); }
    else { key = e.date.slice(0,4); }
    if (!b[key]) b[key] = { key, maxWeight:0, totalVolume:0, sessions:0 };
    const best = bestSet(e);
    if (best && best.weight > b[key].maxWeight) b[key].maxWeight = Number(best.weight)||0;
    b[key].totalVolume += totalVolume(e);
    b[key].sessions += 1;
  }
  return Object.values(b).sort((x,y)=>x.key.localeCompare(y.key));
}
